<Window x:Class="ModLangOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModLangOrganizer.ViewModels"
        xmlns:conv="clr-namespace:ModLangOrganizer.Converters"
        mc:Ignorable="d"
        Title="Mod Lang Organizer"
        Height="780" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
        <conv:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        <conv:IntegrityToColorConverter x:Key="IntegrityToColor"/>
        <conv:SnapshotStateToColorConverter x:Key="SnapshotToColor"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =============================================== -->
        <!--  Custom Title Bar                               -->
        <!-- =============================================== -->
        <Border Grid.Row="0" Background="{StaticResource BgBaseBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Icon (Minecraft-style cube) -->
                    <Border Width="28" Height="28" CornerRadius="6" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource AccentPrimary}" Offset="0"/>
                                <GradientStop Color="{StaticResource AccentSecondary}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⬡" Foreground="White" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Mod Lang Organizer"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v2.4.2" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>

                <!-- jar count badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgElevatedBrush}" 
                            CornerRadius="12" Padding="12,4"
                            Visibility="{Binding ScanCompleted, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                <Run Text="{Binding JarCount, Mode=OneWay}"/>
                                <Run Text="jars"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================================== -->
        <!--  Main Content                                   -->
        <!-- =============================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="24,20,24,20">

                <!-- ======================================= -->
                <!--  Section 1: Folder Selection            -->
                <!-- ======================================= -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📂" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="フォルダ選択" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>

                        <!-- Target Folder -->
                        <TextBlock Text="親フォルダ（jar格納先）" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding TargetDir, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="参照..." 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseFolderCommand}"/>
                        </Grid>

                        <!-- Output Root -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="lang入出力ルート" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding OutputRootSameAsTarget, Converter={StaticResource InverseBool}}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="変更..."
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseOutputCommand}"
                                            IsEnabled="{Binding OutputRootSameAsTarget, Converter={StaticResource InverseBool}}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                  Content="親フォルダと同じ場所をlang入出力ルートにする"
                                  IsChecked="{Binding OutputRootSameAsTarget}"
                                  Margin="0,8,0,0"/>

                        <!-- Resource Pack Output Root (Optional) -->
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="リソースパック出力先（任意 / 未指定時は自動判定）" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                             Text="{Binding ResourcePackOutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="参照..."
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseResourcePackOutputCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="抽出したファイルを編集後、再スキャンして［JARへ反映］を実行します。mapping.jsonに基づき各JARへ正確に反映されます。"/>
                    </StackPanel>
                </Border>

                <!-- ======================================= -->
                <!--  Section 2: Options                     -->
                <!-- ======================================= -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="オプション" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Backup -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="バックアップ" Style="{StaticResource FieldLabel}"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Content="実行前に親フォルダをZipバックアップ"
                                          IsChecked="{Binding BackupZip}"/>
                            </StackPanel>

                            <!-- Cancel Granularity -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="キャンセル粒度" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource ModernRadioButton}"
                                                 Content="jar単位（推奨）"
                                                 GroupName="CancelGranularity"
                                                 IsChecked="{Binding CancelGranularity, Converter={StaticResource EnumToBool}, ConverterParameter=PerJar}"
                                                 Margin="0,0,20,0"/>
                                    <RadioButton Style="{StaticResource ModernRadioButton}"
                                                 Content="ファイル単位"
                                                 GroupName="CancelGranularity"
                                                 IsChecked="{Binding CancelGranularity, Converter={StaticResource EnumToBool}, ConverterParameter=PerFile}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Resource Pack Format -->
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="リソースパック形式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PackFormatOptions}"
                                          SelectedItem="{Binding SelectedPackFormat}"
                                          DisplayMemberPath="DisplayName"
                                          Height="28" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Lang Fallback -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="0,14,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ModernCheckBox}"
                                          Content="langフォールバック（抽出時、ターゲットが無い場合にソースからコピー生成）"
                                          IsChecked="{Binding LangFallbackEnabled}"
                                          Margin="0,0,0,10"/>
                                <Grid IsEnabled="{Binding LangFallbackEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="コピー元ファイル名（拡張子なし）" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding LangFallbackSourceName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="→" FontSize="18"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="14,0,14,6"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="コピー先ファイル名（拡張子なし）" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding LangFallbackTargetName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ======================================= -->
                <!--  Section 3: Action Buttons              -->
                <!-- ======================================= -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🔍  スキャン"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="1" Content="📤  langを抽出"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExecuteCommand}"
                            Margin="0,0,10,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorSuccess}" Offset="0"/>
                                <GradientStop Color="#FF0E9F72" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Grid.Column="2" Content="📥  JARへ反映"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportCommand}"
                            Margin="0,0,10,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorWarning}" Offset="0"/>
                                <GradientStop Color="#FFD97706" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Grid.Column="3" Content="📦  リソースパック出力"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExportResourcePackCommand}"
                            Margin="0,0,10,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3B82F6" Offset="0"/>
                                <GradientStop Color="#FF1D4ED8" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button Grid.Column="4" Content="⏹  キャンセル"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding CancelCommand}"/>

                    <!-- Rescan warning -->
                    <Border Grid.Column="5" Margin="16,0,0,0"
                            CornerRadius="{StaticResource RadiusMd}"
                            Background="#30F59E0B" Padding="14,8"
                            VerticalAlignment="Center"
                            Visibility="{Binding SnapshotFresh, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <TextBlock Text="⚠ jarが変更されています。再スキャンしてください"
                                   FontSize="12" Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- ======================================= -->
                <!--  Section 4: Progress                    -->
                <!-- ======================================= -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                        Padding="20,16">
                    <!-- Show during scan or execute -->
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding ProgressText}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="12" Foreground="{StaticResource AccentLightBrush}">
                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Style="{StaticResource ModernProgressBar}"
                                     Value="{Binding ProgressPercent}" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- Progress during execution -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Padding="20,16">
                    <Border.Visibility>
                        <Binding Path="IsExecuting" Converter="{StaticResource BoolToVis}"/>
                    </Border.Visibility>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding ProgressText}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="12" Foreground="{StaticResource AccentLightBrush}">
                                <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}}"/>
                                <Run Text="%"/>
                            </TextBlock>
                        </Grid>
                        <ProgressBar Style="{StaticResource ModernProgressBar}"
                                     Value="{Binding ProgressPercent}" Maximum="100"/>
                    </StackPanel>
                </Border>

                <!-- ======================================= -->
                <!--  Section 5: Scan Results Table          -->
                <!-- ======================================= -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0"
                        Visibility="{Binding ScanCompleted, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,20,12">
                            <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="スキャン結果" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="10"
                                    Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="{Binding Mods.Count, Mode=OneWay}"/>
                                    <Run Text="件"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <DataGrid DockPanel.Dock="Bottom"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                  CellStyle="{StaticResource ModernDataGridCell}"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  ItemsSource="{Binding Mods}"
                                  MaxHeight="300"
                                  Margin="1,0,1,1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mod名" Binding="{Binding JarFileName}" Width="2*"/>
                                <DataGridTemplateColumn Header="健全性" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IntegrityDisplay}"
                                                       Foreground="{Binding Integrity, Converter={StaticResource IntegrityToColor}}"
                                                       FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="lang" Binding="{Binding LangCountDisplay}" Width="60"/>
                                <DataGridTextColumn Header="方針" Binding="{Binding StrategyDisplay}" Width="90"/>
                                <DataGridTextColumn Header="抽出予定" Binding="{Binding OperationSummary}" Width="*"/>
                                <DataGridTemplateColumn Header="スナップショット" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SnapshotStateDisplay}"
                                                       Foreground="{Binding SnapshotState, Converter={StaticResource SnapshotToColor}}"
                                                       FontWeight="Medium"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ステータス" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2"
                                                    HorizontalAlignment="Left">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{StaticResource BgElevated}"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                           FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ======================================= -->
                <!--  Section 6: Log View                    -->
                <!-- ======================================= -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="20,16,20,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ログ" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="10"
                                        Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="{Binding LogEntries.Count, Mode=OneWay}"/>
                                        <Run Text="件"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <Button Content="💾 ログ保存" 
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveLogCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="12,6"
                                    FontSize="12"/>
                        </Grid>

                        <Border DockPanel.Dock="Bottom"
                                Background="{StaticResource BgDeepBrush}"
                                CornerRadius="0,0,12,12"
                                Padding="4" Margin="1,0,1,1">
                            <ListBox ItemsSource="{Binding LogEntries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="200"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="12,3"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5">
                                            <Run Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]', Mode=OneWay}"
                                                 Foreground="{StaticResource TextMutedBrush}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Level, Mode=OneWay}"
                                                 Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Message, Mode=OneWay}"
                                                 Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- =============================================== -->
        <!--  Status Bar                                     -->
        <!-- =============================================== -->
        <Border Grid.Row="2" Background="{StaticResource BgBaseBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}"
                           FontFamily="{StaticResource UIFont}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                
                <!-- Busy indicator -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource InfoBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="待機中"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Text" Value="スキャン中..."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                        <Setter Property="Text" Value="実行中..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
