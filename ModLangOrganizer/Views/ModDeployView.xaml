<UserControl x:Class="ModLangOrganizer.Views.ModDeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModLangOrganizer.Converters"
             xmlns:models="clr-namespace:ModLangOrganizer.Models"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1260"
             Background="{StaticResource BgDeepBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:EqualityToBoolConverter x:Key="EqToBool"/>
        <conv:EqualityToVisibilityConverter x:Key="EqToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Paths Configuration Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area (Tree & Deploy Panel) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!--  Row 0: Top Paths Configuration Bar                          -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource BgBaseBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Repo Path -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <!-- Target mods Path -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Repo (Mod Warehouse) Path -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="📁" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="管理元 (MOD倉庫):" Style="{StaticResource FieldLabel}" Foreground="{StaticResource InfoBrush}" Margin="0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding RepoPath, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding RepoPath}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="参照..." Style="{StaticResource SecondaryButton}"
                                    Padding="10,6" Margin="0,0,4,0"
                                    Command="{Binding BrowseRepoCommand}"/>
                            <Button Grid.Column="2" Content="📂 開く" Style="{StaticResource SecondaryButton}"
                                    Padding="10,6" Margin="0,0,4,0"
                                    Command="{Binding OpenRepoFolderCommand}"/>
                            <Button Grid.Column="3" Content="🔄 再読込" Style="{StaticResource PrimaryButton}"
                                    Padding="10,6"
                                    Command="{Binding RescanRepoCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- Target (mods) Path -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="🎯" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="適用先 (mods):" Style="{StaticResource FieldLabel}" Foreground="{StaticResource SuccessBrush}" Margin="0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                     Text="{Binding ModsTargetDir, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding ModsTargetDir}" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="参照..." Style="{StaticResource SecondaryButton}"
                                    Padding="10,6" Margin="0,0,4,0"
                                    Command="{Binding BrowseModsTargetCommand}"/>
                            <Button Grid.Column="2" Content="標準mods" Style="{StaticResource SecondaryButton}"
                                    Padding="10,6"
                                    ToolTip="Minecraft標準のmodsフォルダ（%APPDATA%\.minecraft\mods）に設定"
                                    Command="{Binding SetDefaultModsDirCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Options & Info Sub-row -->
                <Grid Margin="0,8,0,0">
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Content="無効フォルダ（_backup, 有効化しないmod 等）もツリーに表示する"
                              IsChecked="{Binding ShowDisabledFolders}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="配置追跡: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,12,0">
                            <TextBlock Text=".modmanager.json" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentLightBrush}"/>
                        </Border>
                        <TextBlock Text="直前退避: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="3" Padding="4,1">
                            <TextBlock Text=".modmanager_backup/" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource AccentLightBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!--  Row 1: Main Content 2-Pane Splitter Area                    -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: MOD Library Tree (48%) -->
                <ColumnDefinition Width="48*" MinWidth="380"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right: Profile & Deploy Controls (52%) -->
                <ColumnDefinition Width="52*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!--  LEFT: MOD LIBRARY HIERARCHICAL TREE                     -->
            <!-- ======================================================== -->
            <Border Grid.Column="0" Background="{StaticResource BgBaseBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search & Batch Buttons Toolbar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Column Headers -->
                        <RowDefinition Height="Auto"/>
                        <!-- Tree View -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Batch Action Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <StackPanel>
                            <!-- Search Bar -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="28,7,8,7" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="0" Text="MOD名・フォルダ名でリアルタイム絞り込み..."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Content="クリア" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Command="{Binding ClearSearchCommand}"/>
                            </Grid>

                            <!-- Batch Operation Buttons -->
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="全選択" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                            Command="{Binding SelectAllCommand}"/>
                                    <Button Content="全解除" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                            Command="{Binding DeselectAllCommand}"/>
                                    <Button Content="選択反転" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11"
                                            Command="{Binding InvertSelectionCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="すべて展開" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                            Command="{Binding ExpandAllCommand}"/>
                                    <Button Content="折りたたむ" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11"
                                            Command="{Binding CollapseAllCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Column Headers -->
                    <Border Grid.Row="1" Background="{StaticResource BgElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,6">
                        <Grid>
                            <TextBlock Text="フォルダ / MODファイル名" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="サイズ" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" Margin="0,0,20,0"/>
                        </Grid>
                    </Border>

                    <!-- Hierarchical TreeView -->
                    <TreeView Grid.Row="2" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding ModTreeRoots}"
                              Padding="10,6">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
                                <Setter Property="FontSize" Value="12.5"/>
                                <Setter Property="Padding" Value="4,3"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tri-state Checkbox -->
                                    <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              IsThreeState="True"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>

                                    <!-- Icon -->
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayIcon}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>

                                    <!-- Item Name & Badge -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDisabledFolder}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="#206C63FF" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DisplayBadge}" FontSize="10.5"
                                                       Foreground="{StaticResource AccentLightBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Size -->
                                    <TextBlock Grid.Column="3" Text="{Binding FormattedSize}"
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="20,0,10,0"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- ======================================================== -->
            <!--  RIGHT: PROFILE & DEPLOY CONTROL PANEL                   -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BgDeepBrush}" Padding="18,14">
                <StackPanel>

                    <!-- 1. Profile Manager Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏷️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="MOD構成プロファイル" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="チェック状態を瞬時に保存・復元"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                          ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="＋ 新規保存" Style="{StaticResource PrimaryButton}"
                                        Padding="12,6" Margin="0,0,4,0"
                                        Command="{Binding NewProfileCommand}"/>
                                <Button Grid.Column="2" Content="💾 上書き" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" Margin="0,0,4,0"
                                        Command="{Binding SaveProfileCommand}"/>
                                <Button Grid.Column="3" Content="🗑 削除" Style="{StaticResource DangerButton}"
                                        Padding="10,6"
                                        Command="{Binding DeleteProfileCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Deployment Settings Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="適用モード設定" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </StackPanel>
                                <!-- Selection Badge -->
                                <Border Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectionSummary}" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Mode Radios -->
                            <StackPanel Margin="0,0,0,10">
                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="{StaticResource RadiusMd}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="12,8" Margin="0,0,0,6">
                                    <RadioButton Style="{StaticResource ModernRadioButton}"
                                                 GroupName="DeployModeRadio"
                                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EqToBool}, ConverterParameter=Sync, Mode=TwoWay}">
                                        <StackPanel Margin="6,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="同期モード (Sync Mode)" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#206C63FF" CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                                    <TextBlock Text="推奨" FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentLightBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="選択MODのみを配置し、過去に配置して外した未選択MODを自動で安全に整理します。"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="※ 手動で直接置かれたMODは保護され、絶対に削除されません。"
                                                       FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>

                                <Border Background="{StaticResource BgSurfaceBrush}" CornerRadius="{StaticResource RadiusMd}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Padding="12,8">
                                    <RadioButton Style="{StaticResource ModernRadioButton}"
                                                 GroupName="DeployModeRadio"
                                                 IsChecked="{Binding SelectedMode, Converter={StaticResource EqToBool}, ConverterParameter=Add, Mode=TwoWay}">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="追加モード (Add Mode)" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="既存MODの削除を一切行わず、選択したMODのみを追加・上書きコピーします。"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Border>
                            </StackPanel>

                            <!-- Backup Checkbox -->
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="反映前に直前のバックアップを自動作成する (.modmanager_backup/)"
                                      IsChecked="{Binding CreateBackup}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Real-time Diff Preview Card -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="反映予定の差分プレビュー" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </StackPanel>
                                <TextBlock Text="事前検証で不整合を未然に防止"
                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Diff Metrics Grid -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- New -->
                                <Border Grid.Column="0" Background="#1510B981" BorderBrush="#4010B981" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="8,6" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="➕ 新規追加" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="{Binding DiffNewCount}" FontSize="18" FontWeight="Black" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Update -->
                                <Border Grid.Column="1" Background="#153B82F6" BorderBrush="#403B82F6" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="8,6" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔄 上書き更新" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                        <TextBlock Text="{Binding DiffUpdateCount}" FontSize="18" FontWeight="Black" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Delete -->
                                <Border Grid.Column="2" Background="#15EF4444" BorderBrush="#40EF4444" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="8,6" Margin="2,0,2,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="➖ 整理削除" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
                                        <TextBlock Text="{Binding DiffDeleteCount}" FontSize="18" FontWeight="Black" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Keep -->
                                <Border Grid.Column="3" Background="#106B7280" BorderBrush="#306B7280" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMd}" Padding="8,6" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏸️ 維持" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DiffKeepCount}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Toggle Diff Details Button -->
                            <Button Style="{StaticResource SecondaryButton}" Height="32"
                                    Margin="0,0,0,6" Command="{Binding ToggleDiffDetailsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▼ 差分ファイル詳細を表示 / 非表示" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{StaticResource AccentLightBrush}"/>
                                </StackPanel>
                            </Button>

                            <!-- Detailed Diff Table -->
                            <Border Background="{StaticResource BgDeepBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Visibility="{Binding IsDiffDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                <DataGrid ItemsSource="{Binding DiffItems}" AutoGenerateColumns="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          Background="Transparent" BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          MaxHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="ファイル名 / 状態" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="6,3">
                                                        <TextBlock Text="{Binding TypeIcon}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="サイズ" Binding="{Binding FormattedSize}" Width="Auto">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Setter Property="Margin" Value="6,3"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="詳細備考" Binding="{Binding Reason}" Width="1.2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Setter Property="Margin" Value="6,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 4. Deploy Action Button -->
                    <Button Height="44" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DeployCommand}" Margin="0,0,0,12">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource SuccessBrush}" Offset="0"/>
                                <GradientStop Color="#FF0D9488" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="modsフォルダへ反映（同期デプロイ）" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 5. Mini Activity Log Console -->
                    <Border Style="{StaticResource TerminalPanel}" Padding="10" Height="100">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="アクティビティ ログ" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding ActivityLogs}"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
